# Local Postgres (docker): see README
DATABASE_URL="postgresql://webethon:webethon_dev@127.0.0.1:5444/webethon?schema=public"
# Signs login sessions. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Set to "false" to disable public candidate signup
ALLOW_PUBLIC_SIGNUP="true"
