# Local Postgres (docker): see README
DATABASE_URL="postgresql://webethon:webethon_dev@127.0.0.1:5444/webethon?schema=public"
# Signs login sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Set to "true" when running behind nginx / Vercel (they set the real client IP)
TRUST_PROXY="false"
# Set to "false" to disable public candidate signup
ALLOW_PUBLIC_SIGNUP="true"
# Hostnames/IPs (comma separated) allowed to open the DEV server remotely, e.g. your server IP
ALLOWED_DEV_ORIGINS=""
# Optional: AI-suggested marks for written answers (any OpenAI-compatible API). Leave empty to mark manually.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Public URL used in report QR codes (optional; defaults to the request host)
APP_URL=""
# Only for plain-http deployments (no certificate yet). Leave empty for HTTPS.
COOKIE_SECURE=""
# Show one-click demo accounts on the login page (demo deployments only)
NEXT_PUBLIC_DEMO_ACCOUNTS=""
